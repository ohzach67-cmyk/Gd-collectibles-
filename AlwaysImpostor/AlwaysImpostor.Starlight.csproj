<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AlwaysImpostor</AssemblyName>
    <RootNamespace>AlwaysImpostor</RootNamespace>
  </PropertyGroup>

  <!-- Starlight Android projects provide their generated Among Us/game/API references.
       Set STARLIGHT_LIB_DIR to the directory containing those assemblies before building. -->
  <ItemGroup Condition="'$(STARLIGHT_LIB_DIR)' != ''">
    <Reference Include="AmongUs">
      <HintPath>$(STARLIGHT_LIB_DIR)/AmongUs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Starlight">
      <HintPath>$(STARLIGHT_LIB_DIR)/Starlight.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
